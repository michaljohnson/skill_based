# ============================================================
# Skill-based architecture — environment variables
# ============================================================
# Copy this file to .env and fill in your values.
# Only ANTHROPIC_API_KEY is required if using the default model.

# --- LLM Provider API Keys (set the one matching your model) ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- LLM Model Selection ---
# Skill-based intentionally targets a smaller model. The deterministic
# skills carry the reasoning load, so the planner can use Haiku.
# See methodology Section 2.1.3 for the rationale.
LLM_MODEL=anthropic/claude-haiku-4-5-20251001

# Per-role override (optional; defaults to LLM_MODEL)
# PLANNER_MODEL=anthropic/claude-haiku-4-5-20251001
